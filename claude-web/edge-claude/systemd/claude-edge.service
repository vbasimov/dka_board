[Unit]
Description=Claude Web edge (second public origin :8443, Tailscale Funnel -> 127.0.0.1:8444)
Documentation=file:/etc/claude-edge/README.md
After=network-online.target
Wants=network-online.target
# Приложение и auth-гейтвей должны быть подняты раньше (Funnel может принять
# запрос сразу после boot). Без Wants: падение app не роняет edge.
After=claude-web.service dsh-gateway-auth.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
# Порт 8444 > 1024: root/CAP_NET_BIND_SERVICE не нужны. Caddy умеет работать
# непривилегированным пользователем (так же, как инстанс auth-гейтвея).
User=caddy
Group=caddy
Environment=HOME=/var/lib/caddy
ExecStart=/usr/bin/caddy run --config /etc/claude-edge/Caddyfile --adapter caddyfile
# admin off в Caddyfile: reload через admin-API недоступен, изменения — restart.
Restart=on-failure
RestartSec=2
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0027

# ── hardening ───────────────────────────────────────────────────────────────
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
# ProtectSystem=strict: единственные записываемые пути — лог edge и HOME
# caddy (storage/OCSP; HTTPS-сайтов нет, но HOME должен быть writable).
ReadWritePaths=/var/log/claude-edge -/var/lib/caddy
# Явно фиксируем read-only входы (дублирует ProtectSystem=strict); префикс «-»
# не роняет старт, если каталог ассетов ещё не создан.
ReadOnlyPaths=/etc/claude-edge -/srv/claude-web/public
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
